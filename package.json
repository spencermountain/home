{
  "name": "home",
  "description": "personal website",
  "private": true,
  "type": "module",
  "repository": "github:spencermountain/home",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "rclone sync ./.output/public r2:home --checksum --transfers 32 --fast-list --progress",
    "deploy:dry": "rclone sync ./.output/public r2:home --checksum --transfers 32 --fast-list --dry-run --progress",
    "lint": "eslint ."
  },
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "nuxt": "^3.17.0",
    "spacetime": "^7.13.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
